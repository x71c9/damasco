---
// One HTML page for every page of the site, at the address given by its
// slugs and the pages it is inside.
import Base from '../layouts/Base.astro'
import Blocks from '../components/Blocks.astro'
import { allPages, pathOf } from '../lib/pages'

export async function getStaticPaths() {
  const pages = await allPages()
  const byId = new Map(pages.map((page) => [page.id, page]))
  return pages.map((page) => {
    const path = pathOf(page, byId)
    return {
      params: { slug: path === '/' ? undefined : path.slice(1, -1) },
      props: { page, paths: Object.fromEntries(pages.map((p) => [p.id, pathOf(p, byId)])) },
    }
  })
}

const { page, paths } = Astro.props
const linkTo = (page: string) => paths[page] ?? '/'
---

<Base page={page}>
  <h1>{page.title}</h1>
  <Blocks blocks={page.blocks} linkTo={linkTo} />
</Base>
