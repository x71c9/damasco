# Lets bubblewrap create user namespaces on distributions that restrict them
# for unprivileged programs (Ubuntu 23.10 and later). The installer adds it
# only when kernel.apparmor_restrict_unprivileged_userns is 1 and no other
# profile already covers /usr/bin/bwrap. It applies to every user of bwrap
# on the machine.

abi <abi/4.0>,
include <tunables/global>

profile damasco-bwrap /usr/bin/bwrap flags=(unconfined) {
  userns,

  include if exists <local/damasco-bwrap>
}
