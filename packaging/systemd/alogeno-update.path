# Starts alogeno-update.service when the panel asks for an update: the
# service runs unprivileged and leaves an empty request file in its data
# directory. Assumes the default data directory.

[Unit]
Description=alogeno update requested from the panel

[Path]
PathExists=/var/lib/alogeno/update-request
Unit=alogeno-update.service

[Install]
WantedBy=paths.target
