[Unit]
Description=alogeno, website builder driven by a coding agent
Documentation=https://github.com/x71c9/alogeno
Requires=alogeno.socket
After=alogeno.socket network-online.target
Wants=network-online.target

[Service]
Type=exec
User=alogeno
Group=alogeno
ExecStart=/usr/local/bin/alogeno --config /etc/alogeno/alogeno.toml serve
Restart=always
RestartSec=2s
TimeoutStopSec=30s

# Data in /var/lib/alogeno, configuration in /etc/alogeno.
StateDirectory=alogeno
StateDirectoryMode=0700
ConfigurationDirectory=alogeno
RuntimeDirectory=alogeno
RuntimeDirectoryMode=0700
UMask=0077

# A cgroup subtree of its own, to run the agent and the builds under memory,
# CPU and process limits. The main process sits in the "main" leaf
# (systemd 254 or later).
Delegate=yes
DelegateSubgroup=main
OOMScoreAdjust=-100

# Hardening that leaves bubblewrap working: it needs user namespaces, its own
# mounts and netlink to bring up loopback in the sandbox.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
