# Installs the latest release of alogeno with its installer, as root, and
# restarts every installation on the machine. Started by alogeno-update.path
# and alogeno-update@<name>.path; `alogeno update` removes their requests
# first.

[Unit]
Description=alogeno update to the latest release
Documentation=https://github.com/x71c9/alogeno/blob/master/docs/install.md#upgrade
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/alogeno update
TimeoutStartSec=15min
