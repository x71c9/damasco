# Installs the latest release of alogeno with its installer, as root. Started
# by alogeno-update.path; `alogeno update` removes the request first.

[Unit]
Description=alogeno update to the latest release
Documentation=https://github.com/x71c9/alogeno/blob/master/docs/install.md#upgrade
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/alogeno --config /etc/alogeno/alogeno.toml update
TimeoutStartSec=15min
