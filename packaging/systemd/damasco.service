[Unit]
Description=damasco, website builder driven by a coding agent
Documentation=https://github.com/x71c9/damasco
Requires=damasco.socket
After=damasco.socket network-online.target
Wants=network-online.target

[Service]
Type=exec
User=damasco
Group=damasco
ExecStart=/usr/local/bin/damasco --config /etc/damasco/damasco.toml serve
Restart=always
RestartSec=2s
TimeoutStopSec=30s

# Data in /var/lib/damasco, configuration in /etc/damasco.
StateDirectory=damasco
StateDirectoryMode=0700
ConfigurationDirectory=damasco
RuntimeDirectory=damasco
RuntimeDirectoryMode=0700
UMask=0077

# A cgroup subtree of its own, to run the agent and the builds under memory,
# CPU and process limits. The main process sits in the "main" leaf
# (systemd 254 or later).
Delegate=yes
DelegateSubgroup=main
OOMScoreAdjust=-100

# Hardening that leaves bubblewrap working: it needs user namespaces, its own
# mounts and netlink to bring up loopback in the sandbox. No
# ProtectKernelLogs=, ProtectKernelTunables= or ProtectHostname=: they mount
# over parts of /proc (kmsg, sys, kernel/hostname), and the kernel then
# refuses the new /proc of the sandbox. The sandbox has its own hostname
# namespace anyway. No RestrictSUIDSGID=: it makes openat2 fail with ENOSYS,
# which bubblewrap 0.11 and later use to set up mounts; NoNewPrivileges=
# already keeps setuid files from granting anything.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelModules=yes
ProtectClock=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
