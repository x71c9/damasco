#!/usr/bin/env bash
# Prints damasco@.service, the unit of a named installation, made from
# damasco.service so that both share every setting: user, directories,
# socket and configuration take the instance name.
#
#   scripts/instance-unit packaging/systemd/damasco.service
set -euo pipefail

unit=${1:?usage: scripts/instance-unit <damasco.service>}
out="$(sed \
  -e 's/^Description=damasco, /Description=damasco %i, /' \
  -e 's/^Requires=damasco\.socket$/Requires=damasco@%i.socket/' \
  -e 's/^After=damasco\.socket /After=damasco@%i.socket /' \
  -e 's/^User=damasco$/User=damasco-%i/' \
  -e 's/^Group=damasco$/Group=damasco-%i/' \
  -e 's#^ExecStart=/usr/local/bin/damasco --config /etc/damasco/damasco\.toml serve$#ExecStart=/usr/local/bin/damasco --config /etc/damasco-%i/damasco.toml serve\nEnvironment=DAMASCO_INSTANCE=%i#' \
  -e 's/^StateDirectory=damasco$/StateDirectory=damasco-%i/' \
  -e 's/^ConfigurationDirectory=damasco$/ConfigurationDirectory=damasco-%i/' \
  -e 's/^RuntimeDirectory=damasco$/RuntimeDirectory=damasco-%i/' \
  -e 's#^\# Data in /var/lib/damasco, configuration in /etc/damasco\.$#\# Data in /var/lib/damasco-<name>, configuration in /etc/damasco-<name>.#' \
  "$unit")"
# Every line that names the default installation must have changed.
for expected in 'Requires=damasco@%i.socket' 'After=damasco@%i.socket' \
  'User=damasco-%i' 'Group=damasco-%i' 'damasco-%i/damasco.toml' \
  'Environment=DAMASCO_INSTANCE=%i' 'StateDirectory=damasco-%i' \
  'ConfigurationDirectory=damasco-%i' 'RuntimeDirectory=damasco-%i'; do
  grep -qF "$expected" <<<"$out" || { echo "instance-unit: $expected missing; damasco.service changed" >&2; exit 1; }
done
printf '# Generated from damasco.service by scripts/instance-unit.\n%s\n' "$out"
