{
  "permissions": {
    "disableBypassPermissionsMode": "disable",
    "allow": ["mcp__damasco", "WebFetch", "WebSearch"]
  },
  "allowManagedPermissionRulesOnly": true,
  "allowManagedHooksOnly": true,
  "allowManagedMcpServersOnly": true,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__claude_ai_.*|Artifact|ArtifactComments|ArtifactData|DesignSync",
        "hooks": [
          { "type": "command", "command": "/opt/damasco/damasco hook", "timeout": 3600 }
        ]
      }
    ]
  }
}
